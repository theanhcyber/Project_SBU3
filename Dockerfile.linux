# syntax=docker/dockerfile:1
# Build:  docker build -t teamboard-api .
# Run:    docker run -p 8080:8080 teamboard-api   ->  http://localhost:8080/swagger

# ============ Stage 1: build — image SDK (có compiler, NuGet, MSBuild; rất nặng) ============
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# 1) Chỉ copy những file quyết định package cần tải: global.json + .csproj
#    => Layer "dotnet restore" chỉ build lại khi các file này đổi.
#    Sửa file .cs không đụng tới chúng => bước restore được lấy từ cache (CACHED).
COPY global.json ./
COPY TestManager.Api/TestManager.Api.csproj TestManager.Api/
RUN dotnet restore TestManager.Api/TestManager.Api.csproj

# 2) Sau đó mới copy toàn bộ source (đã lọc bởi .dockerignore) và publish
COPY . .
RUN dotnet publish TestManager.Api/TestManager.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    -p:UseAppHost=false

# ============ Stage 2: runtime — image ASP.NET (chỉ có runtime, nhẹ hơn nhiều) ============
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Chỉ lấy kết quả publish từ stage build; SDK, source code, obj/ đều bị bỏ lại
COPY --from=build /app/publish .

# Image aspnet từ .NET 8 mặc định lắng nghe cổng 8080 (ASPNETCORE_HTTP_PORTS=8080)
EXPOSE 8080

# Chạy bằng user thường (không phải root) có sẵn trong image aspnet
USER $APP_UID

ENTRYPOINT ["dotnet", "TestManager.Api.dll"]
